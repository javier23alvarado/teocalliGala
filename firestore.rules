rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección /usuarios (Perfiles, Roles, Autenticación)
    match /usuarios/{userId} {
      // 1. Lectura del propio perfil al iniciar sesión
      allow read: if request.auth != null && request.auth.uid == userId;

      // 2. Acceso total para el SuperAdmin original
      allow read, write: if request.auth != null && request.auth.uid == "4J5PxGAHnkM1CaNm7L24hkhkD8A2";

      // 3. Usuarios autenticados pueden consultar listado de miembros
      allow read: if request.auth != null;

      // 4. Creación/Edición/Eliminación por usuarios autenticados
      allow create, update, delete: if request.auth != null;
    }

    // Colección /companias (Catálogo de compañías)
    match /companias/{companyId} {
      allow read, write: if request.auth != null;
    }

    // Documento Único de Boletos Gala (/gala/estadoBoletos)
    match /gala/estadoBoletos {
      allow read, write: if true;
    }

    // Colección /agenda (Ensayos, Presentaciones, Talleres)
    match /agenda/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regla de producción general para cualquier otra colección autenticada
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
